        "build:wporg": "bun bundler/index.js build:wporg",
        "build:github": "bun bundler/index.js build:github",
        "make-pot": "bun bundler/index.js make-pot",
        "update-libs": "bun bundler/index.js update-libs",
        "test": "bun bundler/index.js test",
