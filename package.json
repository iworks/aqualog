        "name": "Marcin Pietrzak",
        "email": "marcin@iworks.pl"
    },
    "requires": {
        "WordPress": "6.0",
        "PHP": "8.1"
    },
    "tested": {
        "WordPress": "7.0"
    },
    "devDependencies": {
        "archiver": "^7",
        "clean-css": "^5",
        "prettier": "^3",
        "sass": "^1.77.0",
        "terser": "^5"
    },
    "scripts": {
